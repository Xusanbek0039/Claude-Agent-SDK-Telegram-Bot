# Majburiy
TELEGRAM_BOT_TOKEN=123456:ABC...
# `claude setup-token` buyrug'i bergan token (claude.ai Pro/Max obunasi)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Botdan foydalanishga ruxsat berilgan Telegram ID'lar (/id buyrug'i bilan bilib olasiz)
ALLOWED_USER_IDS=123456789

# Instagram (Business/Creator akkaunt)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_HOST=graph.facebook.com

# VoiceLab (voicelab.uz) - videoga diktor ovozi
VOICELAB_API_KEY=vlk_...
# Default ovoz: Javohir (yorqin taqdimotchi)
VOICELAB_VOICE_ID=voice_fa56cecf-9b0b-45ba-9ec3-494efb5b301f
# auto: VoiceLab, kredit tugasa bepul Edge TTS | voicelab | edge
TTS_PROVIDER=auto

# OpenAI - AI qahramonlar, stikerlar va fon rasmlari (ixtiyoriy)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

# Shaxsiy avatar: rasmlaringiz papkasi va qahramon kiyimi/uslubi
AVATAR_DIR=husanbek
AVATAR_STYLE=Wearing a dark grey hoodie, modern young IT creator look

# Ixtiyoriy
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Lokal sinovda bo'sh qoldiring (polling). Render'da RENDER_EXTERNAL_URL avtomatik ishlatiladi.
PUBLIC_URL=
WEBHOOK_SECRET=
